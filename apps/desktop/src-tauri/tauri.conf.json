{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Patchwork",
  "version": "0.6.0",
  "identifier": "dev.patchwork.ade",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter patchwork-web dev",
    "beforeBuildCommand": "pnpm --filter patchwork-web build"
  },
  "app": {
    "windows": [
      {
        "title": "Patchwork",
        "width": 1600,
        "height": 960,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/logo.png",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
